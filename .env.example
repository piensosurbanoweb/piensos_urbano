# Copia este archivo como ".env" para desarrollo local (NUNCA subas el .env real a git).
# En Vercel, define esta misma variable en Project Settings -> Environment Variables.

# Cadena de conexión de Supabase (Project Settings -> Database -> Connection string -> URI)
# Usa el modo "Transaction pooler" (puerto 6543) si vas a desplegar en funciones serverless.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:6543/postgres

# Clave secreta para firmar las sesiones de login (JWT). Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y pégala aquí y también en Vercel (Project Settings -> Environment Variables).
# No la compartas ni la subas a git; si cambia, todas las sesiones activas se cierran.
JWT_SECRET=PEGA_AQUI_UNA_CLAVE_ALEATORIA_LARGA

# Clave de la API de Brevo (brevo.com), para enviar el email de "recuperar
# contraseña" y las copias de seguridad. Se usa Brevo en vez de Resend
# porque permite enviar a cualquier destinatario sin tener un dominio
# propio (la web solo tiene el subdominio gratuito de Vercel):
#   1. Crea una cuenta gratuita en brevo.com (plan gratis: 300 emails/día).
#   2. En Settings -> Senders, verifica como remitente un email que ya
#      tengas (por ejemplo piensosurbanoweb@gmail.com): Brevo te manda un
#      correo de confirmación a esa dirección, solo hay que abrirlo y
#      confirmar. No hace falta verificar ningún dominio ni tocar el DNS.
#   3. En SMTP & API -> API Keys, genera una API key y pégala aquí y en
#      Vercel (Project Settings -> Environment Variables).
# Sin esto, ni el "olvidé mi contraseña" ni la copia de seguridad podrán
# enviar correos (el resto de la app funciona igual).
BREVO_API_KEY=PEGA_AQUI_TU_API_KEY_DE_BREVO

# El email que verificaste como remitente en el paso 2 de arriba. Si no se
# define, se usa piensosurbanoweb@gmail.com por defecto.
BREVO_SENDER_EMAIL=piensosurbanoweb@gmail.com

PORT=3000

# Clave secreta para proteger la copia de seguridad automática programada
# (/backup-cron). Vercel la manda sola en la petición del cron si esta
# variable existe, así que solo hay que generarla y pegarla aquí y en Vercel
# (Project Settings -> Environment Variables). Genérala así:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=PEGA_AQUI_UNA_CLAVE_ALEATORIA_LARGA

# Opcional: a qué email se manda la copia de seguridad automática (ver
# vercel.json para la frecuencia). Si no se define, se manda a
# piensosurbanoweb@gmail.com.
BACKUP_EMAIL=piensosurbanoweb@gmail.com
